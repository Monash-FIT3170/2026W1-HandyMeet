{
  "name": "handy-meet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "gesture:model:export": "./scripts/gesture-recognition/.venv/bin/python scripts/gesture-recognition/export_tfjs.py",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "fix": "npm run lint:fix && npm run format",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@livekit/agents": "^1.4.0",
    "@livekit/agents-plugin-deepgram": "^1.4.0",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/postcss": "^4.2.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@tldraw/commenting": "^5.3.1",
    "livekit-client": "^2.18.8",
    "livekit-server-sdk": "^2.15.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.2.4",
    "tldraw": "^5.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.8.1",
    "react-test-renderer": "^19.2.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
